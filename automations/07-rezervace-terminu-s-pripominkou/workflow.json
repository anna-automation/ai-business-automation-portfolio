      "id": "c5d4e3f2-0007-4000-8000-000000000002",
      "name": "Obsazené termíny",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -20,
        240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "Google Calendar — doplnit"
        }
      }
