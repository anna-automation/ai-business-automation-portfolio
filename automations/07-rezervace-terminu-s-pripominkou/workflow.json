    {
      "parameters": {
        "jsCode": "// Poslední kontrola kolize těsně před zápisem. Mezi dotazem do kalendáře\n// a vytvořením události může slot stihnout zabrat někdo jiný.\nconst pozadavek = $('Rezervační formulář').first().json.body;\n\n// Formulář posílá ISO čas s offsetem (např. 2026-03-29T10:30:00+01:00).\n// Lokální text bez offsetu nepřijímáme — v den změny času by vyšel špatně.\nif (!/[+-]\\d{2}:\\d{2}$|Z$/.test(String(pozadavek.start))) {\n  throw new Error('Termín musí přijít v ISO formátu včetně časové zóny.');\n}\n\nconst DELKA_MIN = 30;\nconst start = new Date(pozadavek.start);\nconst konec = new Date(start.getTime() + DELKA_MIN * 60000);\n\n// Rezervace do minulosti a dál než 90 dní nepřijímáme.\nconst nyni = Date.now();\nif (start.getTime() < nyni) throw new Error('Termín už je v minulosti.');\nif (start.getTime() > nyni + 90 * 86400000) throw new Error('Termín je příliš daleko.');\n\n// Překryv: začíná dřív, než končí náš slot, a končí později, než náš začíná.\nconst kolize = $input.all().some((i) => {\n  const e = i.json;\n  if (e.status === 'cancelled') return false;\n  const s = new Date(e.start?.dateTime ?? e.start?.date);\n  const k = new Date(e.end?.dateTime ?? e.end?.date);\n  return s < konec && k > start;\n});\n\n// Obsazeno: vrátíme prázdný výstup a workflow dál nejde.\n// Formulář prázdnou odpověď zobrazí jako „slot už není volný\".\nif (kolize) return [];\n\n// Token pro odkaz na zrušení. Náhodný, ne ID rezervace — ID se dá odhadnout.\nconst token = Array.from(crypto.getRandomValues(new Uint8Array(16)))\n  .map((b) => b.toString(16).padStart(2, '0'))\n  .join('');\n\nreturn [{\n  json: {\n    jmeno: String(pozadavek.jmeno ?? '').trim(),\n    email: String(pozadavek.email ?? '').trim().toLowerCase(),\n    telefon: String(pozadavek.telefon ?? '').trim(),\n    poznamka: String(pozadavek.poznamka ?? '').slice(0, 300),\n    start: start.toISOString(),\n    konec: konec.toISOString(),\n    token,\n    zrusit_url: 'https://n8n.vasefirma.cz/webhook/rezervace-zruseni?token=' + token,\n  },\n}];"
      },
      "id": "c5d4e3f2-0007-4000-8000-000000000003",
      "name": "Kontrola kolize a token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        240
      ]
    },
    {
      "parameters": {
        "operation": "create",
