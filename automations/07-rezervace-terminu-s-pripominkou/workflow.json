    {
      "parameters": {
        "fromEmail": "rezervace@vasefirma.cz",
        "toEmail": "={{ $('Kontrola kolize a token').first().json.email }}",
        "subject": "=Potvrzení rezervace — {{ DateTime.fromISO($('Kontrola kolize a token').first().json.start).setZone('Europe/Prague').toFormat('d. M. yyyy HH:mm') }}",
        "emailFormat": "text",
        "text": "=Dobrý den, {{ $('Kontrola kolize a token').first().json.jmeno }},\n\nmáte potvrzený termín na {{ DateTime.fromISO($('Kontrola kolize a token').first().json.start).setZone('Europe/Prague').toFormat('cccc d. M. yyyy, HH:mm') }} (čas středoevropský).\n\nDen předem Vám přijde připomínka.\n\nPotřebujete termín zrušit? Použijte tento odkaz:\n{{ $('Kontrola kolize a token').first().json.zrusit_url }}\n\nOdkaz je platný jen pro tuto rezervaci. Pokud se nemůžete dostavit, zrušte termín prosím aspoň 12 hodin předem — slot se uvolní někomu dalšímu.\n\nS pozdravem\nVaše firma",
        "options": {}
      },
