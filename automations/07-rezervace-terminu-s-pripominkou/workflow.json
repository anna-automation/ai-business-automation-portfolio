        "start": "={{ $json.start }}",
        "end": "={{ $json.konec }}",
        "additionalFields": {
          "summary": "=Rezervace: {{ $json.jmeno }}",
          "description": "=Kontakt: {{ $json.email }} / {{ $json.telefon }}\nPoznámka: {{ $json.poznamka }}\nzrusit-token: {{ $json.token }}",
          "guestsCanInviteOthers": false,
          "guestsCanModify": false
        }
      },
      "id": "c5d4e3f2-0007-4000-8000-000000000004",
      "name": "Zápis události",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        420,
