    {
      "parameters": {
        "jsCode": "// Checklist se staví z datumu nástupu, ne z „za tři dny\" — termíny musí být absolutní.\nconst n = $json;\nconst nastup = new Date(n.datum_nastupu);\nif (Number.isNaN(nastup.getTime())) {\n  throw new Error('Neplatné datum nástupu: ' + n.datum_nastupu);\n}\n\nconst den = (offset) => {\n  const d = new Date(nastup.getTime() + offset * 86400000);\n  return d.toISOString().slice(0, 10);\n};\n\n// Úkoly před nástupem mají negativní offset. Pokud smlouva přijde na poslední\n// chvíli, termín vyjde do minulosti — to je v pořádku, znamená to „hned\".\nconst sablona = [\n  { ukol: 'Připravit pracovní místo a klíče', vlastnik: 'vedouci', offset: -3 },\n  { ukol: 'Objednat notebook a telefon', vlastnik: 'it', offset: -5 },\n  { ukol: 'Založit účty podle profilu přístupů', vlastnik: 'it', offset: -1 },\n  { ukol: 'Seznámení s týmem a provozem', vlastnik: 'vedouci', offset: 0 },\n  { ukol: 'Školení BOZP a interních pravidel', vlastnik: 'vedouci', offset: 1 },\n  { ukol: 'Kontrola prvního týdne', vlastnik: 'vedouci', offset: 5 },\n];\n\nconst ukoly = sablona.map((s) => ({\n  id_nastupu: n.id_nastupu,\n  jmeno: n.jmeno,\n  pozice: n.pozice,\n  ukol: s.ukol,\n  vlastnik: s.vlastnik === 'it' ? n.it_kontakt : n.vedouci_kontakt,\n  termin: den(s.offset),\n  stav: 'otevreno',\n}));\n\n// Zkušební doba: připomínka dva měsíce po nástupu, ať je čas na rozhodnutí.\nconst zkusebni = new Date(nastup);\nzkusebni.setMonth(zkusebni.getMonth() + 2);\n\nreturn [{\n  json: {\n    ...n,\n    ukoly,\n    pocet_ukolu: ukoly.length,\n    prvni_den: den(0),\n    zkusebni_do: zkusebni.toISOString().slice(0, 10),\n  },\n}];"
      },
