              "id": "c-0001-automat",
              "leftValue": "={{ $json.jeAutomat }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000103",
      "name": "Je to automatická odpověď?",
