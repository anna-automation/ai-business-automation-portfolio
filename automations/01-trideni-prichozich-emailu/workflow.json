      "id": "a1b2c3d4-0001-4000-8000-000000000101",
      "name": "Nová zpráva",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [-240, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "PLACEHOLDER",
          "name": "Gmail — doplnit"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Vytáhne ze zprávy jen to, co potřebuje AI, a označí automatické odpovědi.\nconst vystup = [];\n\nfor (const item of $input.all()) {\n  const h = item.json.headers ?? {};\n  const predmet = item.json.subject ?? '';\n\n  // Záměrně zkrácené tělo: delší zprávy nesou citovanou historii, která\n  // ke klasifikaci nic nepřidá a jen rozšiřuje data poslaná třetí straně.\n  const telo = String(item.json.text ?? item.json.snippet ?? '').slice(0, 2000);\n\n  // Hlavičky, kterými se značí automaty (out-of-office, potvrzenky, newslettery).\n  const jeAutomat =\n    (typeof h['auto-submitted'] === 'string' && h['auto-submitted'] !== 'no') ||\n    Boolean(h['x-autoreply'] || h['x-autorespond'] || h['list-unsubscribe']) ||\n    /^(automaticka|automatická|out of office|mimo kancel)/i.test(predmet);\n\n  vystup.push({\n    json: {\n      id: item.json.id,\n      threadId: item.json.threadId,\n      odesilatel: item.json.from?.value?.[0]?.address ?? '',\n      predmet,\n      jeAutomat,\n      textProAI: 'Od: ' + (item.json.from?.text ?? '') + '\\nPředmět: ' + predmet + '\\n\\n' + telo\n    }\n  });\n}\n\nreturn vystup;"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000102",
      "name": "Příprava textu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "conditions": {
