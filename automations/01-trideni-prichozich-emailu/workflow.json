    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4000-8000-000000000104",
      "name": "Konec — smyčka",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [420, 460]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
