        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "predmet",
              "value": "=Týdenní report {{ $('Výpočet změn').first().json.tyden_od }} – {{ $('Výpočet změn').first().json.tyden_do }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "telo",
              "value": "={{ $json.text }}\n\n— — —\n{{ $('Výpočet změn').first().json.zmeny.map(z => z.nazev + ': ' + z.aktualne + ' (minulý týden ' + z.predchozi + ', rozdíl ' + z.rozdil + ', ' + (z.procenta === null ? 'bez srovnatelné základny' : z.procenta + ' %') + ')').join('\n') }}\n\nČísla spočítal kód z tabulky a CRM, komentář psal model. Report je podklad, ne rozhodnutí.",
              "type": "string"
            }
          ]
        },
        "options": {}
