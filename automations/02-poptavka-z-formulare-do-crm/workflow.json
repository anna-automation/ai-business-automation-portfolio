      "id": "a1b2c3d4-0002-4000-8000-000000000201",
      "name": "Formulář z webu",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-240, 300],
      "webhookId": "a1b2c3d4-0002-4000-8000-00000000wh01"
    },
    {
      "parameters": {
        "jsCode": "// Zvaliduje odeslaný formulář a spočítá kontrolní součet proti duplicitám.\nconst vstup = $input.first().json;\nconst data = vstup.body ?? vstup;\n\nconst ocistit = (v) => String(v ?? '').trim();\n\nconst jmeno = ocistit(data.jmeno);\n// E-mail normalizujeme na malá písmena — jinak by se Jan@firma.cz a jan@firma.cz\n// chovaly jako dvě různé poptávky a duplicitu bychom nepoznali.\nconst email = ocistit(data.email).toLowerCase();\nconst telefon = ocistit(data.telefon);\nconst zprava = ocistit(data.zprava);\nconst honeypot = ocistit(data.web_url);\nconst souhlasText = ocistit(data.souhlas_text);\nconst souhlas = data.souhlas === true || data.souhlas === 'true' || data.souhlas === 'on';\n\nconst chyby = [];\nif (jmeno.length < 2) chyby.push('jmeno');\nif (!/^[^@\\s]+@[^@\\s.]+\\.[^@\\s]{2,}$/.test(email)) chyby.push('email');\nif (zprava.length < 10) chyby.push('zprava_prilis_kratka');\nif (zprava.length > 5000) chyby.push('zprava_prilis_dlouha');\nif (honeypot !== '') chyby.push('honeypot');\nif (!souhlas || souhlasText === '') chyby.push('chybi_souhlas');\n\n// Deterministický hash bez závislostí. Na rozpoznání opakovaného odeslání\n// stačí; není to kryptografická funkce a nemá tak být použit.\nfunction hash(text) {\n  let h = 0;\n  for (let i = 0; i < text.length; i++) {\n    h = (h * 31 + text.charCodeAt(i)) | 0;\n  }\n  return 'p' + Math.abs(h).toString(36);\n}\n\nreturn [{\n  json: {\n    jeValidni: chyby.length === 0,\n    chyby: chyby.join(','),\n    jmeno,\n    email,\n    telefon,\n    zprava,\n    souhlas,\n    souhlasText,\n    hash: hash(email + '|' + zprava.slice(0, 200))\n  }\n}];"
      },
