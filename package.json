{
  "name": "ai-business-automation-portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "Interaktivní showroom firemní automatizace — web + samostatně vedené automatizace",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web",
    "smoke": "npm run smoke --workspace web",
    "n8n:up": "docker compose -f infra/n8n/docker-compose.yml up -d",
    "n8n:down": "docker compose -f infra/n8n/docker-compose.yml down"
  }
}
